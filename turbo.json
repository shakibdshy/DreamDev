{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "db:generate",
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "test": {
      "dependsOn": [
        "^test",
        "db:generate"
      ],
      "cache": false,
      "passThroughEnv": [
        "*"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "*"
      ]
    },
    "db:push": {
      "cache": false,
      "interactive": true
    },
    "db:generate": {
      "cache": false,
      "interactive": false
    },
    "db:migrate": {
      "cache": false,
      "interactive": true
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "deploy": {
      "cache": false,
      "interactive": true
    },
    "destroy": {
      "cache": false,
      "interactive": true
    }
  },
  "globalEnv": [
    "AGENT_API_KEY",
    "AGENT_BASE_URL",
    "AGENT_MODEL",
    "AXIOM_API_KEY",
    "AXIOM_DATASET",
    "AXIOM_EDGE_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "BLOB_READ_WRITE_TOKEN",
    "CI",
    "DATABASE_URL",
    "NODE_ENV",
    "TELEGRAM_BOT_TOKEN",
    "TELEGRAM_BOT_USERNAME",
    "TELEGRAM_WEBHOOK_SECRET",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_PROJECT_PRODUCTION_URL",
    "VERCEL_URL",
    "_VARLOCK_ENV_KEY"
  ],
  "globalDependencies": [
    ".env*",
    "apps/*/.env*",
    "packages/*/.env*"
  ]
}

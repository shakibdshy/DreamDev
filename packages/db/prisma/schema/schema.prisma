// The fund's domain schema (GLOSSARY.md, ADR-0002: one typed table per ledger
// entry — never a polymorphic transactions table). All money is integer taka.
// Months are "YYYY-MM" strings; dates are date-only Credit Dates (Asia/Dhaka).

generator client {
  provider     = "prisma-client"
  output       = "../generated"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Member {
  id          String    @id @default(uuid())
  name        String
  mobile      String    @unique
  joiningDate DateTime  @db.Date
  address     String?
  photo       String?
  notes       String?
  status      String    @default("active") // active | inactive | exited
  exitDate    DateTime? @db.Date
  // Telegram binding (receive-only notifications, #14). One chat per member.
  telegramChatId   String?
  telegramLinkedAt DateTime?
  notifyEnabled    Boolean @default(true)
  deletedAt   DateTime?
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([telegramChatId])

  contributions  Contribution[]
  loans          Loan[]
  loanRepayments LoanRepayment[]
  adjustments    Adjustment[]
  shareAllotments ShareAllotment[]
  statusChanges  MemberStatusChange[]

  @@map("member")
}

model ShareAllotment {
  id             String   @id @default(uuid())
  memberId       String
  quantity       Int
  effectiveMonth String // YYYY-MM
  createdBy      String?
  createdAt      DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id])

  @@index([memberId, effectiveMonth])
  @@map("share_allotment")
}

model BankAccount {
  id             String  @id @default(uuid())
  bankName       String
  accountNumber  String?
  address        String?
  openingBalance Int     @default(0)
  deletedAt      DateTime?
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contributions     Contribution[]
  loansOut          Loan[]             @relation("LoanBank")
  loanRepayments    LoanRepayment[]
  expenses          Expense[]
  transfersFrom     Transfer[]         @relation("TransferFrom")
  transfersTo       Transfer[]         @relation("TransferTo")

  @@map("bank_account")
}

model Contribution {
  id               String    @id @default(uuid())
  memberId         String
  bankAccountId    String
  amount           Int
  creditDate       DateTime  @db.Date
  sharePriceAtEntry Int
  shareQtyAtEntry  Int
  note             String?
  deletedAt        DateTime?
  createdBy        String?
  updatedBy        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])
  member      Member      @relation(fields: [memberId], references: [id])

  @@index([memberId, creditDate])
  @@index([bankAccountId, creditDate])
  @@map("contribution")
}

model Loan {
  id            String    @id @default(uuid())
  memberId      String
  bankAccountId String
  amount        Int
  date          DateTime  @db.Date
  note          String?
  deletedAt     DateTime?
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bankAccount BankAccount     @relation("LoanBank", fields: [bankAccountId], references: [id])
  member      Member          @relation(fields: [memberId], references: [id])
  repayments  LoanRepayment[]

  @@index([memberId])
  @@map("loan")
}

model LoanRepayment {
  id            String    @id @default(uuid())
  loanId        String
  memberId      String
  bankAccountId String
  amount        Int
  creditDate    DateTime  @db.Date
  deletedAt     DateTime?
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  loan        Loan        @relation(fields: [loanId], references: [id])
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])
  member      Member      @relation(fields: [memberId], references: [id])

  @@index([loanId])
  @@index([bankAccountId, creditDate])
  @@map("loan_repayment")
}

model Expense {
  id            String    @id @default(uuid())
  bankAccountId String
  amount        Int
  date          DateTime  @db.Date
  note          String?
  deletedAt     DateTime?
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])

  @@index([bankAccountId, date])
  @@map("expense")
}

model Transfer {
  id            String    @id @default(uuid())
  fromAccountId String
  toAccountId   String
  amount        Int
  date          DateTime  @db.Date
  note          String?
  deletedAt     DateTime?
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  fromAccount BankAccount @relation("TransferFrom", fields: [fromAccountId], references: [id])
  toAccount   BankAccount @relation("TransferTo", fields: [toAccountId], references: [id])

  @@index([fromAccountId])
  @@index([toAccountId])
  @@map("transfer")
}

model Adjustment {
  id        String    @id @default(uuid())
  memberId  String
  amount    Int
  month     String?
  reason    String
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  member Member @relation(fields: [memberId], references: [id])

  @@index([memberId])
  @@map("adjustment")
}

model MemberStatusChange {
  id        String   @id @default(uuid())
  memberId  String
  status    String // active | inactive | exited
  date      DateTime @db.Date
  note      String?
  createdBy String?
  createdAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id])

  @@index([memberId, date])
  @@map("member_status_change")
}

// Effective-dated global Share Price (GLOSSARY.md): a change applies from its
// month forward; past months never re-bill. First entry seeded at ৳5,000.
model SharePriceEntry {
  id             String   @id @default(uuid())
  effectiveMonth String // YYYY-MM
  price          Int
  createdAt      DateTime @default(now())

  @@unique([effectiveMonth])
  @@map("share_price_entry")
}

// AI agent audit trail (spec #14): every agent conversation, message, and
// tool call is persisted — the agent acts as a User and must be reviewable.
// One ongoing conversation per user per channel; threadId is opaque.
model AgentConversation {
  id        String         @id @default(uuid())
  userId    String
  threadId  String
  channel   String         @default("web") // web | telegram
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  messages  AgentMessage[]

  @@unique([userId, threadId])
  @@map("agent_conversation")
}

model AgentMessage {
  id             String            @id @default(uuid())
  conversationId String
  role           String // user | assistant | tool
  content        String            @default("")
  // Tool audit: set when role = "tool"
  toolName       String?
  toolArgsJson   String?
  toolResultJson String?
  createdAt      DateTime          @default(now())

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("agent_message")
}

// Single-use deep-link pairing codes binding a Telegram chat to a dashboard
// User or a Member (#14). 15-minute TTL; consumed on /start.
model TelegramPairingCode {
  id         String    @id @default(uuid())
  code       String    @unique
  targetType String // user | member
  targetId   String
  expiresAt  DateTime
  usedAt     DateTime?
  createdBy  String?
  createdAt  DateTime  @default(now())

  @@index([targetType, targetId])
  @@map("telegram_pairing_code")
}

// Server-held approval pauses for Telegram agent turns (#14): the webhook is
// A paused confirm survives in the DB until its callback claims it (atomic
// delete = the claim) or the 10-minute expiry lapses. Both transports use it:
// Telegram rows carry chatId (one pause per chat), web rows leave it null —
// Postgres unique indexes ignore NULLs, so concurrent web pauses are fine.
// The (threadId, interruptId) key is the replay-proof claim for web resumes:
// a spent interrupt can never be claimed twice (#23).
model AgentPausedApproval {
  id               String   @id @default(uuid())
  chatId           String?  @unique
  userId           String
  threadId         String
  interruptId      String
  interruptedRunId String
  toolName         String
  argsJson         String
  messagesJson     String // exact AG-UI snapshot the resume rebuilds from
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  @@unique([threadId, interruptId])
  @@map("agent_paused_approval")
}

// Delivery log for member Telegram notifications (#14): one row per event,
// deduped per (record, event, member); failed sends retry on the member's
// next touching write using the stored content.
model NotificationLog {
  id                String    @id @default(uuid())
  memberId          String
  type              String // contribution_recorded | contribution_updated | contribution_deleted | loan_recorded | loan_deleted | repayment_recorded | adjustment_recorded | adjustment_updated | adjustment_deleted | shares_changed | status_changed
  recordId          String
  status            String // sent | failed | skipped-no-chat | disabled
  content           String
  telegramMessageId Int?
  error             String?
  retriedAt         DateTime?
  createdAt         DateTime  @default(now())

  @@unique([recordId, type, memberId])
  @@index([memberId, status])
  @@map("notification_log")
}

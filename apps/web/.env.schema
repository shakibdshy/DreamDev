# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local, auto=false)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @internal @required=false
VERCEL_ENV=

# @internal @required=false
VERCEL_URL=

# @internal @required=false
VERCEL_PROJECT_PRODUCTION_URL=

# @internal @required=false @type=url(prependHttps=true)
VERCEL_ORIGIN=if(eq($VERCEL_ENV, production), fallback($VERCEL_PROJECT_PRODUCTION_URL, $VERCEL_URL), fallback($VERCEL_URL, $VERCEL_PROJECT_PRODUCTION_URL))

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=$VERCEL_ORIGIN

# Supplied by Alchemy at runtime; builds do not need ingest credentials.
# @dynamic @required=false @type=string(minLength=1)
AXIOM_API_KEY=

# Supplied by Alchemy at runtime; builds do not need ingest credentials.
# @dynamic @required=false @type=string(minLength=1)
AXIOM_DATASET=

# Supplied by Alchemy at runtime; builds do not need ingest credentials.
# @dynamic @required=false @type=url
AXIOM_EDGE_URL=

# @type=string(minLength=1)
DATABASE_URL=

# Vercel Blob token for Member photos (ADR-0003). Optional: without it photo
# upload returns 503 and everything else works.
# @required=false @type=string(minLength=1)
BLOB_READ_WRITE_TOKEN=

# GLM via the z.ai OpenAI-compatible endpoint powers the fund agent (#14).
# Optional: without a key the agent API returns 503 and everything else works.
# @required=false @type=string(minLength=1)
AGENT_API_KEY=

# @required=false @type=url
AGENT_BASE_URL=

# The model id appears in agent SSE metadata by design (TanStack AI writes
# it into every message) — it is a public identifier, not a secret.
# @public @required=false @type=string(minLength=1)
AGENT_MODEL=

# Telegram bot for the fund agent (#14). Optional: without a token the
# webhook returns 503 and pairing stays hidden; everything else works.
# @required=false @type=string(minLength=1)
TELEGRAM_BOT_TOKEN=

# Shared secret Telegram echoes in X-Telegram-Bot-Api-Secret-Token.
# @required=false @type=string(minLength=1)
TELEGRAM_WEBHOOK_SECRET=

# Public bot username (without @) used to build t.me deep links.
# @public @required=false @type=string(minLength=1)
TELEGRAM_BOT_USERNAME=
